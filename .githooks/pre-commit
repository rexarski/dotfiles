#!/bin/sh
# Refresh the per-machine manifests (skills.txt, tinycast-extensions.txt)
# and stage them. Enable once per clone: git config core.hooksPath .githooks
repo=$(git rev-parse --show-toplevel)
"$repo/scripts/skills-manifest.sh" || exit 1
"$repo/scripts/tinycast-manifest.sh" || exit 1
for f in skills.txt tinycast-extensions.txt; do
  [ -f "$repo/$f" ] && git add "$repo/$f"
done
exit 0
